rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Hồ sơ người dùng & danh sách bạn bè
    match /users/{uid} {
      allow read, write: if true;
      match /friends/{friendUid} {
        allow read, write: if true;
      }
    }

    // 2. Bài viết / Ảnh widget (lưu trực tiếp base64 trong document)
    match /posts/{postId} {
      allow read, write: if true;
    }

    // 3. Tương thích luồng cũ
    match /friend_requests/{reqId} {
      allow read, write: if true;
    }

    // 4. Trạng thái Tri Kỷ (Soulmate status & radar)
    match /soulmate_status/{uid} {
      allow read, write: if true;
    }

    // 5. Tương tác trực tiếp Tri Kỷ (Heartbeat, Poke, Hug, v.v.)
    match /soulmate_interactions/{interactionId} {
      allow read, write: if true;
    }

    // 6. Lời mời kết đôi Tri Kỷ
    match /soulmate_requests/{requestId} {
      allow read, write: if true;
    }

    // 7. Ảnh bí mật (Secret Scratch Photos)
    match /secret_photos/{photoId} {
      allow read, write: if true;
    }
  }
}
